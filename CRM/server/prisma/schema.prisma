generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  QUOTED
  APPROVED
  REJECTED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

enum QcStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PREPARING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum CustomsStatus {
  PENDING
  IN_REVIEW
  CLEARED
  HELD
  CANCELLED
}

enum LedgerEntryType {
  REVENUE
  COST
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  APPROVED
  VOID
}

enum ConsignmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
  PARTIALLY_DELIVERED
  REFUNDED
}

enum ConsignmentProductCategory {
  MOBILE
  LAPTOP
  ACCESSORY
  OTHER
}

enum ConsignmentProductStatus {
  PENDING
  DELIVERED
  REFUNDED
  RETURNED
  DAMAGED
}

enum ConsignmentTransactionMethod {
  CASH
  BANK
  MOBILE
  CARD
  OTHER
}

enum ConsignmentTransactionType {
  ADVANCE
  PAYMENT
  REFUND
  PAY_IN
  PAY_OUT
}

enum ConsignmentTransactionDirection {
  IN
  OUT
}

enum ConsignmentTransactionParty {
  CUSTOMER
  SUPPLIER
  COMPANY
}

enum ConsignmentTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  taxId           String?
  notes           String?
  status          CustomerStatus   @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  users           User[]
  productRequests ProductRequest[]
  quotations      Quotation[]
  purchaseOrders  PurchaseOrder[]
  qcReports       QcReport[]
  shipments       Shipment[]
  customsRecords  CustomsRecord[]
  ledgerEntries   LedgerEntry[]
  consignments    Consignment[]

  @@index([name])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("customers")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  notes          String?
  status         SupplierStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  purchaseOrders PurchaseOrder[]
  qcReports      QcReport[]
  customsRecords CustomsRecord[]
  ledgerEntries  LedgerEntry[]
  consignments   Consignment[]

  @@index([name])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("suppliers")
}

model ProductRequest {
  id             String               @id @default(cuid())
  requestNumber  String               @unique
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  status         ProductRequestStatus @default(DRAFT)
  assignedUserId String?
  assignedUser   User?                @relation("AssignedProductRequests", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User                 @relation("CreatedProductRequests", fields: [createdById], references: [id], onDelete: Restrict)
  items          ProductRequestItem[]
  quotations     Quotation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  @@index([customerId])
  @@index([status])
  @@index([assignedUserId])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("product_requests")
}

model ProductRequestItem {
  id               String         @id @default(cuid())
  productRequestId String
  productRequest   ProductRequest @relation(fields: [productRequestId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  quantity         Int
  targetPrice      Decimal?       @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([productRequestId])
  @@map("product_request_items")
}

model Quotation {
  id               String          @id @default(cuid())
  quotationNumber  String          @unique
  productRequestId String
  productRequest   ProductRequest  @relation(fields: [productRequestId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status           QuotationStatus @default(DRAFT)
  currency         String          @default("USD")
  serviceFeeRate   Decimal         @default(0) @db.Decimal(5, 4)
  subtotal         Decimal         @db.Decimal(12, 2)
  serviceFee       Decimal         @db.Decimal(12, 2)
  shippingFee      Decimal         @default(0) @db.Decimal(12, 2)
  tax              Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  validUntil       DateTime?
  notes            String?
  createdById      String
  createdBy        User            @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById     String?
  approvedBy       User?           @relation("ApprovedQuotations", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  sentAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  items            QuotationItem[]
  purchaseOrders   PurchaseOrder[]

  @@index([productRequestId])
  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([quotationId])
  @@map("quotation_items")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  orderNumber          String              @unique
  quotationId          String
  quotation            Quotation           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status               PurchaseOrderStatus @default(DRAFT)
  currency             String              @default("USD")
  subtotal             Decimal             @db.Decimal(12, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(12, 2)
  tax                  Decimal             @default(0) @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  expectedDeliveryDate DateTime?
  notes                String?
  createdById          String
  createdBy            User                @relation("CreatedPurchaseOrders", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById         String?
  approvedBy           User?               @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  submittedAt          DateTime?
  productionStartedAt  DateTime?
  shippedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  items                PurchaseOrderItem[]
  qcReports            QcReport[]
  ledgerEntries        LedgerEntry[]

  @@index([quotationId])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  quantity        Int
  unitCost        Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  shipmentItems   ShipmentItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model QcReport {
  id              String        @id @default(cuid())
  reportNumber    String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inspectorId     String
  inspector       User          @relation("QcInspections", fields: [inspectorId], references: [id], onDelete: Restrict)
  status          QcStatus      @default(PENDING)
  inspectionDate  DateTime?
  notes           String?
  photoUrls       String[]      @default([])
  createdById     String
  createdBy       User          @relation("CreatedQcReports", fields: [createdById], references: [id], onDelete: Restrict)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([purchaseOrderId])
  @@index([customerId])
  @@index([supplierId])
  @@index([inspectorId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("qc_reports")
}

model Shipment {
  id                    String          @id @default(cuid())
  shipmentNumber        String          @unique
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status                ShipmentStatus  @default(PENDING)
  carrier               String?
  trackingNumber        String?
  shippingMethod        String?
  origin                String?
  destination           String?
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  notes                 String?
  createdById           String
  createdBy             User            @relation("CreatedShipments", fields: [createdById], references: [id], onDelete: Restrict)
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  items                 ShipmentItem[]
  customsRecords        CustomsRecord[]
  ledgerEntries         LedgerEntry[]

  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("shipments")
}

model ShipmentItem {
  id                  String            @id @default(cuid())
  shipmentId          String
  shipment            Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  quantity            Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([shipmentId, purchaseOrderItemId])
  @@index([shipmentId])
  @@index([purchaseOrderItemId])
  @@map("shipment_items")
}

model CustomsRecord {
  id                String        @id @default(cuid())
  recordNumber      String        @unique
  shipmentId        String
  shipment          Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId        String?
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status            CustomsStatus @default(PENDING)
  declarationNumber String?
  customsOffice     String?
  country           String?
  dutyAmount        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(12, 2)
  otherFees         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("USD")
  exchangeRate      Decimal       @default(1) @db.Decimal(12, 6)
  clearanceDate     DateTime?
  notes             String?
  createdById       String
  createdBy         User          @relation("CreatedCustomsRecords", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       String?
  updatedBy         User?         @relation("UpdatedCustomsRecords", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  clearedAt         DateTime?
  heldAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([shipmentId])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("customs_records")
}

model LedgerEntry {
  id                   String            @id @default(cuid())
  entryNumber          String            @unique
  purchaseOrderId      String?
  purchaseOrder        PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  shipmentId           String?
  shipment             Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customerId           String?
  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId           String?
  supplier             Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  type                 LedgerEntryType
  status               LedgerEntryStatus @default(PENDING)
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("USD")
  exchangeRate         Decimal           @default(1) @db.Decimal(12, 6)
  amountInBaseCurrency Decimal           @db.Decimal(12, 2)
  description          String?
  reference            String?
  occurredAt           DateTime          @default(now())
  createdById          String
  createdBy            User              @relation("CreatedLedgerEntries", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById         String?
  approvedBy           User?             @relation("ApprovedLedgerEntries", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  voidedAt             DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([purchaseOrderId])
  @@index([shipmentId])
  @@index([customerId])
  @@index([supplierId])
  @@index([type])
  @@index([status])
  @@index([occurredAt])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
  @@map("ledger_entries")
}

model Attachment {
  id              String    @id @default(cuid())
  entityType      String
  entityId        String
  originalName    String
  mimeType        String
  size            Int
  storageProvider String    @default("cloudinary")
  storageKey      String
  resourceType    String
  format          String?
  uploadedById    String
  uploadedBy      User      @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([storageProvider, storageKey])
  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("attachments")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  status                  UserStatus               @default(ACTIVE)
  roleId                  String
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  customerId              String?                  @unique
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  assignedProductRequests ProductRequest[]         @relation("AssignedProductRequests")
  createdProductRequests  ProductRequest[]         @relation("CreatedProductRequests")
  createdQuotations       Quotation[]              @relation("CreatedQuotations")
  approvedQuotations      Quotation[]              @relation("ApprovedQuotations")
  createdPurchaseOrders   PurchaseOrder[]          @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders  PurchaseOrder[]          @relation("ApprovedPurchaseOrders")
  qcInspections           QcReport[]               @relation("QcInspections")
  createdQcReports        QcReport[]               @relation("CreatedQcReports")
  createdShipments        Shipment[]               @relation("CreatedShipments")
  createdCustomsRecords   CustomsRecord[]          @relation("CreatedCustomsRecords")
  updatedCustomsRecords   CustomsRecord[]          @relation("UpdatedCustomsRecords")
  createdLedgerEntries    LedgerEntry[]            @relation("CreatedLedgerEntries")
  deviceTokens            DeviceToken[]
  approvedLedgerEntries   LedgerEntry[]            @relation("ApprovedLedgerEntries")
  uploadedAttachments     Attachment[]             @relation("UploadedAttachments")
  adminConsignments       Consignment[]            @relation("AdminConsignments")
  addedConsignmentTxns    ConsignmentTransaction[] @relation("AddedConsignmentTransactions")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdByIp         String?
  revokedByIp         String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DeviceToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  deviceName String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model Consignment {
  id                String                   @id @default(cuid())
  consignmentId     String                   @unique
  adminId           String
  admin             User                     @relation("AdminConsignments", fields: [adminId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  startDate         DateTime                 @default(now())
  shippingDate      DateTime?
  deliveryDate      DateTime?
  shippingCost      Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal                  @default(0) @db.Decimal(12, 2)
  totalAdvance      Decimal                  @default(0) @db.Decimal(12, 2)
  totalDue          Decimal                  @default(0) @db.Decimal(12, 2)
  totalProductCost  Decimal                  @default(0) @db.Decimal(12, 2)
  totalSellingPrice Decimal                  @default(0) @db.Decimal(12, 2)
  grossProfit       Decimal                  @default(0) @db.Decimal(12, 2)
  netProfit         Decimal                  @default(0) @db.Decimal(12, 2)
  profitMargin      Decimal                  @default(0) @db.Decimal(12, 4)
  totalReceived     Decimal                  @default(0) @db.Decimal(12, 2)
  totalPaid         Decimal                  @default(0) @db.Decimal(12, 2)
  status            ConsignmentStatus        @default(PENDING)
  destination       String                   @default("Bangladesh")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  products          ConsignmentProduct[]
  transactions      ConsignmentTransaction[]

  @@index([adminId])
  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("consignments")
}

model ConsignmentProduct {
  id                String                     @id @default(cuid())
  consignmentId     String
  consignment       Consignment                @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  category          ConsignmentProductCategory
  brand             String
  model             String
  specs             String?
  buyingPrice       Decimal                    @db.Decimal(12, 2)
  sellingPrice      Decimal                    @db.Decimal(12, 2)
  quantity          Int
  totalBuyingCost   Decimal                    @default(0) @db.Decimal(12, 2)
  totalSellingCost  Decimal                    @default(0) @db.Decimal(12, 2)
  position          Int                        @default(0)
  status            ConsignmentProductStatus   @default(PENDING)
  deliveredQuantity Int                        @default(0)
  refundedQuantity  Int                        @default(0)
  profit            Decimal                    @default(0) @db.Decimal(12, 2)
  profitMargin      Decimal                    @default(0) @db.Decimal(12, 4)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([consignmentId, position])
  @@map("consignment_products")
}

model ConsignmentTransaction {
  id            String                          @id @default(cuid())
  consignmentId String
  consignment   Consignment                     @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  transactionId String
  date          DateTime                        @default(now())
  amount        Decimal                         @db.Decimal(12, 2)
  method        ConsignmentTransactionMethod
  type          ConsignmentTransactionType
  direction     ConsignmentTransactionDirection
  party         ConsignmentTransactionParty
  note          String?
  addById       String?
  addBy         User?                           @relation("AddedConsignmentTransactions", fields: [addById], references: [id], onDelete: SetNull)
  status        ConsignmentTransactionStatus    @default(COMPLETED)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([consignmentId, transactionId])
  @@index([consignmentId])
  @@index([addById])
  @@map("consignment_transactions")
}
