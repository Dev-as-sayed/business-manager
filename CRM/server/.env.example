NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://s_omnia_user:StrongPassword123!@localhost:5433/s_omnia_db?schema=public

# Comma-separated allowlist. Include the Electron origin used in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,app://.
TRUST_PROXY=false

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Auth (use at least 32 random characters each)
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30

# Optional cookie signing secret
COOKIE_SECRET=replace-with-a-cookie-secret

# Initial Super Admin created by the seed script
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin

# Finance
BASE_CURRENCY=USD

# Cloudinary attachments
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_FOLDER=crm/attachments

# Uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
