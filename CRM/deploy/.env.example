# Copy to deploy/.env and replace every placeholder before deploying.
# Run compose with: docker compose --env-file deploy/.env -f docker-compose.prod.yml ...

DOMAIN=crm.example.com

POSTGRES_DB=s_omnia_db
POSTGRES_USER=s_omnia_user
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://s_omnia_user:replace-with-strong-password@postgres:5432/s_omnia_db?schema=public

NODE_ENV=production
PORT=4000
TRUST_PROXY=true
LOG_LEVEL=info

CORS_ORIGINS=https://crm.example.com,app://.

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30

COOKIE_SECRET=replace-with-a-cookie-secret

SEED_ADMIN_EMAIL=admin@crm.example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin

BASE_CURRENCY=USD

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_FOLDER=crm/attachments

UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
